# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Cloud Service Account (for Document AI / Cloud Storage / etc.)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_CLIENT_EMAIL=your-sa@project.iam.gserviceaccount.com
GOOGLE_PROJECT_ID=your-project-id

# Stripe Keys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Site URL & Security
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SITE_PASSWORD=your-site-password
RESEND_API_KEY=re_...

# ─── Stripe Products & Prices ──────────────────────────────────────────────
# Main Subscription / Plan Product IDs (replace with live prod_xxx IDs for live mode)
NEXT_PUBLIC_STRIPE_PRODUCT_INDIVIDUAL=prod_...
NEXT_PUBLIC_STRIPE_PRODUCT_PLUS=prod_...
NEXT_PUBLIC_STRIPE_PRODUCT_PROFESSIONAL=prod_...
NEXT_PUBLIC_STRIPE_PRODUCT_AGENCY=prod_...

# (Optional) Direct Price IDs (price_xxx) if you prefer passing price IDs instead of product IDs
NEXT_PUBLIC_STRIPE_PRICE_INDIVIDUAL=
NEXT_PUBLIC_STRIPE_PRICE_PLUS=
NEXT_PUBLIC_STRIPE_PRICE_PROFESSIONAL=
NEXT_PUBLIC_STRIPE_PRICE_AGENCY=

# Credit Top-Ups (Scans) Product IDs
NEXT_PUBLIC_STRIPE_TOPUP_INDIVIDUAL=prod_...
NEXT_PUBLIC_STRIPE_TOPUP_PLUS=prod_...
NEXT_PUBLIC_STRIPE_TOPUP_PROFESSIONAL=prod_...
NEXT_PUBLIC_STRIPE_TOPUP_AGENCY=prod_...

